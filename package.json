{
  "name": "react-datetime-kit",
  "version": "0.1.0",
  "description": "A modern, accessible React date & time picker library — single date, date range, time, time range, datetime, and datetime range pickers. Works in both JS and TS.",
  "keywords": [
    "react",
    "date",
    "time",
    "datepicker",
    "timepicker",
    "date-range",
    "time-range",
    "datetime",
    "calendar",
    "tailwind",
    "typescript",
    "accessible",
    "a11y"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "postcss src/styles.css -o dist/styles.css",
    "build:site": "vite build --outDir ../dist-site --emptyOutDir",
    "preview:site": "vite preview --outDir ../dist-site",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"playground/**/*.{ts,tsx,html,css}\"",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "date-fns": ">=2.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "date-fns": "^3.6.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
