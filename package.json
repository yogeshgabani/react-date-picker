{
  "name": "react-datetime-kit",
  "version": "1.2.4",
  "description": "Modern, accessible, customizable React date picker, time picker, date range picker, time range picker, datetime picker and datetime range picker — TypeScript-first, themeable, mobile-friendly, with keyboard navigation, ARIA support, RTL, i18n, dark mode and Moment-style format tokens.",
  "keywords": [
    "react",
    "react-component",
    "reactjs",
    "react-datepicker",
    "react-date-picker",
    "react-timepicker",
    "react-time-picker",
    "react-datetimepicker",
    "react-datetime-picker",
    "react-calendar",
    "react-date-range",
    "react-daterangepicker",
    "react-date-range-picker",
    "react-time-range",
    "react-time-range-picker",
    "react-datetime-range",
    "react-datetime-kit",
    "datepicker",
    "date-picker",
    "timepicker",
    "time-picker",
    "datetime-picker",
    "datetimepicker",
    "daterangepicker",
    "date-range-picker",
    "date-range",
    "time-range",
    "datetime-range",
    "datetime",
    "date",
    "time",
    "calendar",
    "calendar-component",
    "picker",
    "range-picker",
    "month-picker",
    "year-picker",
    "scheduler",
    "booking",
    "appointment",
    "popover",
    "input",
    "form",
    "form-control",
    "form-field",
    "ui",
    "ui-kit",
    "ui-library",
    "ui-component",
    "component",
    "component-library",
    "headless",
    "headless-ui",
    "hooks",
    "customizable",
    "themeable",
    "themable",
    "dark-mode",
    "light-mode",
    "responsive",
    "mobile",
    "mobile-friendly",
    "touch",
    "accessible",
    "accessibility",
    "a11y",
    "aria",
    "wcag",
    "keyboard",
    "keyboard-navigation",
    "focus",
    "rtl",
    "right-to-left",
    "i18n",
    "internationalization",
    "localization",
    "locale",
    "date-fns",
    "moment",
    "moment-format",
    "floating-ui",
    "tailwind",
    "tailwindcss",
    "css-variables",
    "typescript",
    "ts",
    "tsx",
    "jsx",
    "es6",
    "esm",
    "tree-shakeable",
